#: schema/project-level/project-schema.json:1
msgid "Related lot(s)"
msgstr "Lote(s) relacionado(s)"

#. /definitions/Finance/properties/relatedLots/description
#: schema/project-level/project-schema.json:1
msgid ""
"The identifiers of the lots to which the financing arrangement relates."
msgstr ""
"Los identificadores de los lotes a los que se refiere el acuerdo de "
"finananciamiento."

